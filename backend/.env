# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Postgres ────────────────────────────────────────
DATABASE_URL=postgres://myuser:mypassword@localhost:5432/myapp
DB_POOL_MAX=20

# ── Auth ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-plus-char-string-please
JWT_EXPIRES_IN=15m

# ── CORS ────────────────────────────────────────────
CLIENT_URLS=http://localhost:5173